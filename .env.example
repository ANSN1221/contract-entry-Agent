# 复制为 .env 后填写。.env 已在 .gitignore 中，不会入库。
# cp .env.example .env

# ---- 运行环境 ----
ENV=dev
LOG_LEVEL=INFO

# ---- LLM：DeepSeek（字段抽取/生成）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Embedding：硅基流动（OpenAI 兼容）----
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ---- 数据层 ----
# SQLite 起步；D14 切 PostgreSQL 只改这一行
DATABASE_URL=sqlite:///./data/app.db

# ---- 鉴权与限流 ----
# 三档：填 SECRET 用短期签名 token；只填 API_TOKEN 用长期静态 token；
# 都不填则 dev/test 放行、prod 全拒（fail closed）。
# 生成密钥：python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN_SECRET=
API_TOKEN_TTL_SECONDS=3600
API_TOKEN=
RATE_LIMIT_PER_MINUTE=120
